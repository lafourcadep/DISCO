units metal
dimension 3
boundary p p p
atom_style atomic

read_data ../Geo_40x40x40_with_loop.lmp

pair_style eam/alloy
pair_coeff * * Ta1_Ravelo_2013.eam.alloy Ta

thermo 100
thermo_style custom step pe ke etotal temp press lx ly lz 

dump d1 all custom 100 dir.dumps/dump.*.dump id x y z

velocity all create 500.0 4928459

fix 1 all nve

variable lxtmp equal lx
  
run 0

variable lx0 equal ${lxtmp}
variable defx equal 0.95
variable lxnew equal ${defx}*${lx0}

fix 2 all deform 1 x final 0.0 ${lxnew} y volume z volume

run 1

unfix 1
unfix 2

#fix 2 all deform 1 x trate -1.0e-3 y volume z volume
fix 1 all nvt temp 500. 500. 0.1

run 50000
  